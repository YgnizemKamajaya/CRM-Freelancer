# Dependencies
/node_modules
/vendor

# Environment
.env
.env.backup
.env.production
.env.*.local

# Build output
/public/build
/public/hot
/public/storage

# Storage keys & tooling caches
# (per-directory .gitignore files under storage/ already keep user uploads —
#  vault, goal-banners, public — out of version control.)
/storage/*.key
/storage/pail
/auth.json
.phpactor.json
.phpunit.result.cache
/.phpunit.cache

# SQLite local database (remove these lines if you commit a seeded db on purpose)
/database/*.sqlite
/database/*.sqlite-journal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE
/.fleet
/.idea
/.nova
/.vscode
/.zed
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Homestead
Homestead.json
Homestead.yaml

# Deliverable archives
/*.zip
